<Window x:Class="ClipboardQueueApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Focusable="True"
        Title="ClipFlow"
        Height="500"
        Width="700">

    <Grid Margin="10">
        <Grid.Resources>
            <!-- Converters for Visibility Logic -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </Grid.Resources>
    
        <Grid.RowDefinitions>
            <!-- Header Row -->
            <RowDefinition Height="Auto"/>
            <!-- Search Row -->
            <RowDefinition Height="Auto"/>
            <!-- Content Row -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="ClipFlow" FontSize="20" FontWeight="Bold" 
                       Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Clear All" Command="{Binding ClearAllCommand}" 
                        ToolTip="Clear all items from history" Cursor="Hand"
                        Padding="10,5" Margin="5,0"/>
            </StackPanel>
        </Grid>

        <!-- SEARCH BAR -->
        <!-- Filters the list based on text input -->
        <TextBox Grid.Row="1" Margin="0,0,0,10" Padding="5"
                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />

        <!-- EMPTY STATE -->
        <Grid Grid.Row="2" Panel.ZIndex="0">
             <TextBlock Text="No items in history" 
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Foreground="{DynamicResource SecondaryFg}" FontSize="16"/>
             <Grid.Style>
                 <Style TargetType="Grid">
                     <Setter Property="Visibility" Value="Collapsed"/>
                     <Style.Triggers>
                         <DataTrigger Binding="{Binding Items.Count}" Value="0">
                             <Setter Property="Visibility" Value="Visible"/>
                         </DataTrigger>
                     </Style.Triggers>
                 </Style>
             </Grid.Style>
        </Grid>

        <!-- LIST -->
        <ListBox Grid.Row="2" ItemsSource="{Binding FilteredItems}" 
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="{DynamicResource CardBg}"/>
                    <Setter Property="Margin" Value="0,0,0,5"/>
                    <Setter Property="Padding" Value="5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="5" Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="true">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.InputBindings>
                             <MouseBinding Gesture="LeftDoubleClick" 
                                           Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           CommandParameter="{Binding}"/>
                        </Grid.InputBindings>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <!-- Helper text -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="{Binding CopiedAt, StringFormat=t}" 
                                           FontSize="10" Foreground="{DynamicResource SecondaryFg}"/>
                                <TextBlock Text=" • " FontSize="10" Foreground="{DynamicResource SecondaryFg}"/>
                                <TextBlock FontSize="12" Foreground="Goldenrod" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value=""/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="Text" Value="📌"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            
                            <TextBlock Text="{Binding Text}" 
                                       TextTrimming="CharacterEllipsis" 
                                       MaxHeight="36" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Fg}"/>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                             <Button Content="✎" 
                                     ToolTip="Edit" Cursor="Hand"
                                     Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                     CommandParameter="{Binding}"
                                     Background="Transparent" BorderThickness="0" Margin="2"/>
                             <Button Content="📌" 
                                     ToolTip="Pin/Unpin" Cursor="Hand"
                                     Command="{Binding DataContext.PinCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                     CommandParameter="{Binding}"
                                     Background="Transparent" BorderThickness="0" Margin="2"/>
                             <Button Content="🗑️" 
                                     ToolTip="Delete" Cursor="Hand"
                                     Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                     CommandParameter="{Binding}"
                                     Background="Transparent" BorderThickness="0" Margin="2"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- STATUS OVERLAY -->
        <!-- Displays ephemeral messages (Snackbars) at the bottom of the screen -->
        <Border Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" 
                Margin="20" Background="#CC000000" CornerRadius="20" Padding="15,8"
                Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontWeight="SemiBold"/>
        </Border>

    </Grid>
</Window>