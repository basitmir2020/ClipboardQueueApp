<Window x:Class="ClipboardQueueApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Focusable="True"
        Title="Clipboard Queue"
        Height="500"
        Width="700">

    <DockPanel>

        <TextBox
            DockPanel.Dock="Top"
            Margin="5"
            Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />

        <ListBox ItemsSource="{Binding FilteredItems}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}"
                               TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>